{
  "name": "a2adependencyinspector",
  "title": "A2A Dependency Inspector",
  "description": "A paid remote MCP for A2A dependency inspector MCP, built to return verdicts, receipts, usage logs, and audit-ready JSON for agent and CI workflows.",
  "version": "1.0.0",
  "websiteUrl": "https://a2adependencyinspector.clauxel.com/",
  "documentationUrl": "https://a2adependencyinspector.clauxel.com/mcp/",
  "endpointUrl": "https://a2adependencyinspector.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://a2adependencyinspector.clauxel.com/api/agent-checkout",
